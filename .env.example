# アプリの公開 URL (例: http://localhost:3000)
APP_URL=
# Neon (Postgres) の接続文字列
DATABASE_URL=
# Better Auth のセッション署名用シークレット
BETTER_AUTH_SECRET=
# ログインを許可するメールアドレス (カンマ区切り)
ALLOWED_EMAILS=
# Google OAuth のクライアント ID
GOOGLE_CLIENT_ID=
# Google OAuth のクライアントシークレット
GOOGLE_CLIENT_SECRET=
# GitHub App の App ID
GITHUB_APP_ID=
# GitHub App の秘密鍵 (PEM)
GITHUB_APP_PRIVATE_KEY=
# GitHub App のクライアント ID
GITHUB_APP_CLIENT_ID=
# GitHub App のクライアントシークレット
GITHUB_APP_CLIENT_SECRET=
# GitHub Webhook の署名検証用シークレット
GITHUB_WEBHOOK_SECRET=
# Asana の Personal Access Token
ASANA_PAT=
# Asana のワークスペース GID
ASANA_WORKSPACE_GID=
# Asana のチーム GID (任意。組織のワークスペースでは必要)
ASANA_TEAM_GID=
# Cron エンドポイント呼び出し用のシークレット
CRON_SECRET=
